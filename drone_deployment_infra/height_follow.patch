+    def test_valid(self):
+        umbrella, ext = self.parse(["height_follow:6,7", "formation:4,5"], follow=4)
+        self.assertEqual(sorted(umbrella.owner), [4, 5, 6, 7])
+        self.assertEqual(umbrella.owner[6].name, "height_follow")
+        self.assertEqual(umbrella.owner[6].source, 4)
+        self.assertEqual(umbrella.owner[4].name, "formation")
+        self.assertEqual(ext[0][1], [4, 5])
+
+    def test_existing_policies_unchanged(self):
