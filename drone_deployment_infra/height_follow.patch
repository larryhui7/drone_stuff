+class FakeFormationDrone:
+    """What publish_telemetry reads off a formation drone: name, state, height, status
+    timestamp, takeoff-confirmed flag, rc, and no tag fix (est -> None)."""
+
+    def __init__(self, num, height, st_age, clock, flying=True):
+        self.name = f"drone{num}"
+        self.state = "HOLDING"
+        self.h = height
+        self.st_t = clock.t - st_age
+        self.last_rc = [0, 0, 0, 0]
+        self.to_state = True if flying else "pending"
+        self.airborne = flying
+        self.landing = self.landed = False
+
+    def height_cm(self):
+        return self.h
+
+    def est(self, now):
+        return None
+
+
+@unittest.skipUnless(HAVE_FORMATION, "swarm_formation.py needs cv2/numpy/yaml")
+class PublisherContractTest(unittest.TestCase):
+    """The real publish_telemetry -> HeightFollowPolicy contract, no handcrafted dicts."""
+
+    def test_publish_telemetry_feeds_height_follow(self):
+        clock = Clock()
+        with mock.patch("time.time", clock), mock.patch("time.monotonic", clock):
+            p = make_policy()
+            d6 = FakeDrone(6, 100.0)
+            p.setup([d6])
+            p.step(d6, 0.0)                                # capture 100
+            src = FakeFormationDrone(SRC, 200.0, 0.1, clock)
+            src.st_t = clock.t - 0.1
+            swarm_formation.publish_telemetry(p.bus, [src], clock.t)
+            clock.advance(0.2)
+            p.step(d6, 0.0)
+            self.assertAlmostEqual(p.tgt[6], 102.0)          # 10 cm/s * 0.2 s
+            d6.h = 102.0
+            # not flying: pending takeoff, failed takeoff, dry-run, landing
+            for attr, val in (("to_state", "pending"), ("to_state", False),
+                              ("airborne", False), ("landing", True)):
+                setattr(src, attr, val)
+                src.st_t = clock.t - 0.1
+                swarm_formation.publish_telemetry(p.bus, [src], clock.t)
+                clock.advance(0.1)
+                p.step(d6, 0.0)
+                self.assertAlmostEqual(p.tgt[6], 102.0)    # latched, not chasing a dead source
+                src.to_state, src.airborne, src.landing, src.landed = True, True, False, False
+            src.st_t = clock.t - 0.6                        # height measurement goes stale
+            swarm_formation.publish_telemetry(p.bus, [src], clock.t)
+            clock.advance(0.1)
+            p.step(d6, 0.0)
+            self.assertAlmostEqual(p.tgt[6], 102.0)        # still latched: 0.6 s old is too old
+            src.st_t = clock.t - 0.1                       # valid again: control
+            swarm_formation.publish_telemetry(p.bus, [src], clock.t)
+            clock.advance(0.1)
+            p.step(d6, 0.0)
+            self.assertAlmostEqual(p.tgt[6], 103.0)        # tracking resumes
