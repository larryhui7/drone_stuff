new file mode 100644
index 0000000..5f6f154
--- /dev/null
+++ b/drone_deployment_infra/swarm_ops/test_height_follow.py
@@ -0,0 +1,410 @@
+#!/usr/bin/env python3
+"""Offline tests for the height_follow policy: fake drones, a real TelemetryBus, a fake
+clock - no sockets, no drones. Run from anywhere: python test_height_follow.py
+"""
+import os
+import sys
+import unittest
+from unittest import mock
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.join(HERE, "..", "core"))
+
+import swarm_policies  # noqa: E402  (parse_runs, headroom_cm, CLI checks)
+from policies import HeightFollowPolicy, TelemetryBus  # noqa: E402
+
+SRC = 4                      # the formation drone being followed
+
+
+class Clock:
+    """One time for both time.time (telemetry freshness) and time.monotonic (slew)."""
+
+    def __init__(self, t=1000.0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+    def advance(self, dt):
+        self.t += dt
+
+
+class FakeDrone:
+    def __init__(self, num, height=None):
+        self.num, self.name = num, f"drone{num}"
+        self.h = height
+
+    def height_cm(self):
+        return self.h
+
+
+def make_policy(**kw):
+    p = HeightFollowPolicy(SRC, **kw)
+    p.bus = TelemetryBus()
+    p.setup([])
+    return p
+
+
+class HeightFollowTest(unittest.TestCase):
+    def setUp(self):
+        self.clock = Clock()
+        for name in ("time.time", "time.monotonic"):
+            patcher = mock.patch(name, self.clock)
+            patcher.start()
+            self.addCleanup(patcher.stop)
+        self.p = make_policy()
+        self.d = FakeDrone(6, height=100.0)
+
+    def step(self, d=None):
+        return self.p.step(d or self.d, 0.0)
+
+    def publish(self, p=None, state="HOLDING", height=200, st_age=0.1, flying=True,
+                topic=None, data=None):
+        p = p or self.p
+        p.bus.publish(topic or f"formation/drone{SRC}",
+                      data if data is not None else {"state": state, "height_cm": height,
+                                                     "st_age": st_age, "flying": flying},
+                      self.clock.t)
+
+    def tgt(self, d=None):
+        return self.p.tgt[(d or self.d).num]
+
+    # -- first step --
+    def test_first_step_no_height(self):
+        self.d.h = None
+        self.assertEqual(self.step(), (0, 0, 0, 0))
+        self.assertNotIn(self.d.num, self.p.tgt)          # nothing captured yet
+        self.d.h = 100.0
+        self.assertEqual(self.step(), (0, 0, 0, 0))
+        self.assertEqual(self.tgt(), 100.0)               # captured once a height exists
+
+    # -- fresh source: slew toward it --
+    def test_tracks_fresh_source_with_slew(self):
+        self.step()                                       # captures 100
+        self.publish(height=200)                          # fresh source at 200
+        self.clock.advance(0.5)
+        self.publish(height=200)                          # the real source re-publishes every tick
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)          # 10 cm/s * 0.5 s
+        self.clock.advance(0.2)
+        self.publish(height=200)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 107.0)          # irregular intervals
+        a, b, c, yaw = self.p.step(self.d, 0.0)
+        self.assertEqual((a, b, yaw), (0, 0, 0))            # lateral + yaw always 0
+
+    def test_slew_cap_after_a_stall(self):
+        self.step()
+        self.clock.advance(10.0)                           # dt caps at 0.5 s
+        self.publish(height=250)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)          # not 100 + 10*10
+
+    def test_bounds(self):
+        self.step()
+        p = make_policy(slew_cm_s=10000.0)                 # reach the clamp in one step
+        p.setup([self.d])
+        p.step(self.d, 0.0)                                # capture 100
+        self.publish(p, height=300)
+        self.clock.advance(0.1)
+        self.publish(p, height=300)
+        p.step(self.d, 0.0)
+        self.assertEqual(p.tgt[6], 250.0)                   # clamped high
+        self.publish(p, height=2)
+        self.clock.advance(0.1)
+        self.publish(p, height=2)
+        p.step(self.d, 0.0)
+        self.assertEqual(p.tgt[6], 40.0)                    # clamped low
+
+    # -- dead source: latch the measured height once, then hold it --
+    def test_no_source_holds_takeoff_height(self):
+        self.step()
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)           # never published: stay put
+
+    def test_source_loss_latches_immediately_and_holds(self):
+        self.step()
+        for _ in range(5):                                 # climb: target 150, drone still at 100
+            self.clock.advance(0.5)
+            self.publish(height=250)
+            self.step()
+        self.assertAlmostEqual(self.tgt(), 125.0)
+        self.d.h = 100.0                                   # drone lags the target
+        self.clock.advance(1.0)                            # source goes silent
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)          # latched NOW, not slewed toward 100
+        self.d.h = 112.0                                   # drone drifts during the loss
+        self.clock.advance(1.0)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)          # fixed reference, no drift-chasing
+        self.publish(height=250)                           # source recovers
+        self.clock.advance(0.5)
+        self.publish(height=250)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)         # resumes at the same slew
+        self.clock.advance(0.5)
+        self.publish(height=250)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 110.0)
+
+    def test_stale_and_invalid_latch_measured(self):
+        self.step()
+        self.clock.advance(0.5)
+        self.publish(height=250)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)
+        self.d.h = 105.0                                   # where it really is
+        for state, h in (("LANDED", 250), ("HOLDING", None)):
+            self.publish(state=state, height=h)            # fresh but not usable
+            self.clock.advance(0.5)
+            self.step()
+            self.assertAlmostEqual(self.tgt(), 105.0)       # latched to measured
+        self.publish(data="not a dict")                    # malformed payload
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)
+        self.publish(height=True)                          # bool sneaks past isinstance(int)
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)
+        self.clock.advance(1.0)                            # source goes silent: telemetry stale
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 105.0)
+
+    def test_st_age_must_be_recent(self):
+        self.step()
+        self.publish(st_age=2.0)                           # measurement itself is old
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)          # ignored
+        self.publish(data={"state": "HOLDING", "height_cm": 200})   # no st_age at all
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)
+        self.publish(st_age=True)                          # bool is not an age
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)
+        self.publish(height=200, st_age=0.4)               # 0.4 old when published...
+        self.clock.advance(0.2)                           # ...0.2 s ago: 0.6 total, too old
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)
+        self.publish(height=200, st_age=0.3)               # 0.3 + 0.1 = 0.4: recent enough
+        self.clock.advance(0.1)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 101.0)
+
+    def test_flying_flag_required(self):
+        self.step()
+        self.publish(flying=False)                         # takeoff not confirmed yet
+        self.clock.advance(0.1)                           # keep the age valid: flag is the test
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)          # ignored
+        self.publish(data={"state": "HOLDING", "height_cm": 200,
+                          "st_age": 0.1})                 # no flying key
+        self.clock.advance(0.1)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)
+        self.publish()                                    # control: flying and fresh
+        self.clock.advance(0.1)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 101.0)
+
+    def test_rejects_nan_and_future_timestamps(self):
+        self.step()
+        self.publish(st_age=float("nan"))                 # nan sneaks past < and > checks
+        self.clock.advance(0.1)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)
+        self.p.bus.publish(f"formation/drone{SRC}",
+                          {"state": "HOLDING", "height_cm": 200, "st_age": 0.1,
+                           "flying": True}, self.clock.t + 5)   # timestamp from the future
+        self.clock.advance(0.1)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)          # negative publication age: no
+
+    def test_initial_hold_is_fixed(self):
+        self.step()                                       # captures 100
+        self.d.h = 112.0                                   # measured height drifts, no source yet
+        self.clock.advance(0.5)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 100.0)          # holds the CAPTURED height, not 112
+
+    # -- the follower's own height --
+    def test_follower_height_loss_freezes_target(self):
+        self.step()
+        self.clock.advance(0.5)
+        self.publish(height=250)
+        self.step()                                        # tgt 105, source fresh
+        self.d.h = None                                    # follower's height drops out
+        self.assertEqual(self.step(), (0, 0, 0, 0))
+        self.assertAlmostEqual(self.tgt(), 105.0)          # frozen, not advancing
+        self.clock.advance(2.0)                           # stays fresh + heightless a while
+        self.publish(height=250)
+        self.assertEqual(self.step(), (0, 0, 0, 0))
+        self.assertAlmostEqual(self.tgt(), 105.0)
+        self.d.h = 105.0                                   # measurements return
+        self.clock.advance(0.5)
+        self.publish(height=250)
+        self.step()
+        self.assertAlmostEqual(self.tgt(), 110.0)          # normal slew resumes
+
+    # -- setup resets per-drone state --
+    def test_setup_resets(self):
+        self.step()
+        self.publish(height=250)
+        self.clock.advance(0.5)
+        self.step()
+        self.assertTrue(self.p.tgt)
+        self.p.setup([self.d])
+        self.assertEqual(self.p.tgt, {})                   # fresh run, nothing captured
+        self.assertEqual(self.step(), (0, 0, 0, 0))
+        self.assertAlmostEqual(self.tgt(), 100.0)
+
+    # -- independent followers --
+    def test_followers_are_independent(self):
+        d7 = FakeDrone(7, height=60.0)
+        self.p.setup([self.d, d7])
+        self.step(self.d)
+        self.step(d7)                                      # both capture their own height
+        for _ in range(3):
+            self.clock.advance(0.5)
+            self.publish(height=250)
+            self.step(self.d)
+            self.step(d7)
+        self.assertAlmostEqual(self.tgt(self.d), 115.0)    # from 100
+        self.assertAlmostEqual(self.tgt(d7), 75.0)         # from 60, its own baseline
+        self.clock.advance(1.0)                            # source dies
+        self.step(self.d)
+        self.step(d7)
+        self.assertAlmostEqual(self.tgt(self.d), 100.0)    # each latches its own height
+        self.assertAlmostEqual(self.tgt(d7), 60.0)
+
+    # -- publishes its own telemetry --
+    def test_publishes_own_topic(self):
+        self.step()
+        self.clock.advance(0.5)
+        self.publish(height=200)
+        self.step()
+        hit = self.p.bus.latest("height_follow/drone6", max_age=1.0)
+        self.assertIsNotNone(hit)
+        self.assertEqual(hit[0], {"src": "drone4", "target_cm": 105})
+        self.clock.advance(1.0)                            # source goes silent: telemetry stale
+        self.step()
+        hit = self.p.bus.latest("height_follow/drone6", max_age=1.0)
+        self.assertEqual(hit[0], {"src": None, "target_cm": 100})   # back to measured
