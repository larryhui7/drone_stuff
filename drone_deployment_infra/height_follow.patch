+"""height_follow: copy one formation drone's height, read from the telemetry bus.
+
+Each drone takes off and holds the height the takeoff left it at until the source's
+"formation/drone<N>" telemetry is usable (published recently, its height measurement
+recent - st_age plus publication age - and the source flying), then slews its commanded
+target toward that height (clamped to min_cm..max_cm, at most slew_cm_s). Losing the
+source latches the follower's height at that moment and holds that fixed reference until
+the source recovers; losing the follower's own height freezes its target until
+measurements return. Lateral rc and yaw stay 0: no horizontal hold, no collision
+avoidance - keep its drones out of the formation's space (in front of tag 10). The
+runner still lands a drone that loses its status stream or its battery.
+"""
+import math
+import time
+
+from .base import Policy, hold_height
+
+FLYING_STATES = ("CLIMB", "SEARCH", "LOCKED", "FACE10", "APPROACH", "HOLDING")
+MAX_AGE_S = 0.5                # the topic must be published this recently
+MAX_MEAS_AGE_S = 0.5           # ... and the height itself be this old (st_age + publication)
+
+
+def _finite_num(v):
+    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
+
+
+class HeightFollowPolicy(Policy):
+    name = "height_follow"
+
+    def __init__(self, source, min_cm=40, max_cm=250, max_age=MAX_AGE_S, slew_cm_s=10.0):
+        self.source, self.min_cm, self.max_cm = source, min_cm, max_cm
+        self.max_age, self.slew_cm_s = max_age, slew_cm_s
+
+    def setup(self, drones):
+        super().setup(drones)
+        self.tgt, self.last_t, self.hold = {}, {}, {}   # target, last step, held reference
+
+    def _source_cm(self):
+        """The source's height, or None: no fresh telemetry, not flying, or no recent height."""
+        hit = self.bus.latest(f"formation/drone{self.source}", self.max_age)
+        if hit is None:
+            return None
+        d, pub_age = hit
+        if not isinstance(d, dict) or d.get("state") not in FLYING_STATES \
+                or d.get("flying") is not True:
+            return None
+        st_age = d.get("st_age")                        # age of the height measurement itself
+        if not _finite_num(st_age) or st_age < 0 or not _finite_num(pub_age) or pub_age < 0:
+            return None                                 # nan, or a timestamp from the future
+        if st_age + pub_age > MAX_MEAS_AGE_S:           # how old the height really is
+            return None
+        h = d.get("height_cm")
+        if not _finite_num(h) or not 0 < h <= 400:
+            return None
+        return h
+
+    def step(self, d, t):
+        now = time.monotonic()
+        h = d.height_cm()
+        if d.num not in self.tgt:
+            if h is None:                                # no height yet: nothing to hold
+                return (0, 0, 0, 0)
+            ref = max(self.min_cm, min(self.max_cm, h))   # first height: what we hold
+            self.tgt[d.num], self.hold[d.num], self.last_t[d.num] = ref, ref, now
+            return (0, 0, 0, 0)
+        prev_t = self.last_t.get(d.num)
+        self.last_t[d.num] = now                         # refresh the timing baseline every step
+        if h is None:                                    # no height: freeze the target, zero rc
+            self.bus.publish(f"height_follow/{d.name}",
+                             {"src": None, "target_cm": round(self.tgt[d.num])})
+            return (0, 0, 0, 0)
+        src = self._source_cm()
+        if src is None:                    # no usable source: hold the latched reference
+            if d.num not in self.hold:                    # lost it mid-flight: latch NOW
+                self.hold[d.num] = max(self.min_cm, min(self.max_cm, h))
+            self.tgt[d.num] = self.hold[d.num]
+        else:
+            self.hold.pop(d.num, None)
+            dt = max(0.0, min(now - prev_t, 0.5)) if prev_t is not None else 0.0
+            want = max(self.min_cm, min(self.max_cm, src))
+            step_max = self.slew_cm_s * dt
+            self.tgt[d.num] += max(-step_max, min(step_max, want - self.tgt[d.num]))
+        self.bus.publish(f"height_follow/{d.name}",
+                         {"src": f"drone{self.source}" if src is not None else None,
+                          "target_cm": round(self.tgt[d.num])})
+        return (0, 0, hold_height(d, self.tgt[d.num]), 0)
+
+    def describe(self, d):
+        t = self.tgt.get(d.num)
+        return f"{self.name} drone{self.source}" + (f" {t:.0f}cm" if t is not None else "")
